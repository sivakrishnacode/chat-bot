// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  industry  String?
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  flows     BotFlow[]
}

model BotFlow {
  id          String     @id @default(cuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nodes       FlowNode[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
}

model FlowNode {
  id         String   @id @default(cuid())
  key        String
  title      String
  message    String   @db.Text
  replies    String[] @default([])
  targets    String[] @default([])
  inputType  String   @default("quick_reply") // "quick_reply" | "form"
  formFields String?  @db.Text              // JSON array of { label, type, required, placeholder }
  isStart    Boolean  @default(false)
  posX       Int      @default(0)
  posY       Int      @default(0)
  flowId     String
  flow       BotFlow  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([flowId, key])
  @@index([flowId])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Hashed password
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

